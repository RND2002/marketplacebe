{
  "name": "fixkar-backend",
  "version": "1.0.0",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "prisma generate && tsc",
    "start": "prisma db push && node dist/server.js",
    "test": "jest",
    "lint": "eslint src --ext .ts",
    "postinstall": "prisma generate",
    "db:push": "prisma db push",
